# Zirp portal settings. Copy to .env.local (or run: npm run check).
# Only ZIRP_API_URL is required.

# Where the Zirp Site Service API listens (reached by this server, not by phones).
ZIRP_API_URL=http://127.0.0.1:8760

# Shown in the page header and the browser tab.
ZIRP_SITE_NAME=Zirp Parking

# Port for `npm start` (Next.js reads PORT; default 3000).
PORT=3000

# Set to "true" when the portal is served over HTTPS (secure admin cookie).
ZIRP_SECURE_COOKIES=false

# Optional support line shown on the pay page.
ZIRP_SUPPORT_PHONE=
