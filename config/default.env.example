SMARTPARK_APP_NAME=SmartPark Edge
SMARTPARK_SITE_NAME=Parking Site
SMARTPARK_API_HOST=127.0.0.1
SMARTPARK_API_PORT=8760
SMARTPARK_HVX_HOST_URL=http://127.0.0.1:8765
# Optional. Defaults to the repo OcxConfig/ vendor package.
# SMARTPARK_HVX_VENDOR_DIR=C:\path\to\OcxConfig
SMARTPARK_DEFAULT_HVX_SDK_PORT=30000
SMARTPARK_GATE_PHYSICAL_CONTROL_ENABLED=false

# --- Mobile money: ClickPesa -------------------------------------------------
# ClickPesa has no sandbox: these are LIVE keys and real money moves. Collection
# stays off until BOTH switches below are true. Payments are verified with
# ClickPesa server-side (webhook hint + reconciliation every 60 s); a browser
# or webhook alone never marks a visit paid.
# SMARTPARK_PAYMENTS_MOBILE_PROVIDER=clickpesa
# SMARTPARK_CLICKPESA_CLIENT_ID=
# SMARTPARK_CLICKPESA_API_KEY=
# SMARTPARK_CLICKPESA_CHECKSUM_KEY=
# SMARTPARK_CLICKPESA_LIVE_ENABLED=true
# SMARTPARK_PAYMENTS_LIVE_PROVIDER_CONFIRMED=true
# Webhooks need a public HTTPS hostname forwarding /api/webhooks/clickpesa to
# this server (e.g. a Cloudflare Tunnel); without one, reconciliation still
# confirms payments within about a minute.
# SMARTPARK_PUBLIC_INGRESS_HOSTS=pay.example.com
